{
  "expo": {
    "name": "아보카도",
    "slug": "soksok-voca",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "soksokvoca",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "cover",
      "backgroundColor": "#2A7B78"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.soksokvoca",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Allow 아보카도 to use speech recognition for voice input.",
        "NSMicrophoneUsageDescription": "Allow 아보카도 to use the microphone for voice input."
      }
    },
    "android": {
      "package": "com.soksokvoca",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#2A7B78",
        "foregroundImage": "./assets/images/icon.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "fonts": []
        }
      ],
      "@react-native-google-signin/google-signin",
      "expo-web-browser",
      "expo-sqlite",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow 아보카도 to use the microphone for voice input.",
          "speechRecognitionPermission": "Allow 아보카도 to use speech recognition for voice input."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "2d560de2-a41b-4ac1-a019-d287f7aaa2d6"
      }
    }
  }
}
