{
  "cli": {
    "version": ">= 18.5.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true
    },
    "widget-dev": {
      "extends": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "WIDGET_DEV": "1"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6776714408"
      },
      "android": {
        "track": "internal"
      }
    }
  }
}
