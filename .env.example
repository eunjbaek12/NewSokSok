# Local development environment ------------------------------------------
# Copy this file to .env and fill in values. .env is gitignored.

# Supabase project (https://supabase.com — Settings → API)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Google Sign-In Web Client ID (Google Cloud Console → Credentials)
EXPO_PUBLIC_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# Optional — dev scripts only (scripts/*.ts, scripts/*.mjs).
# Production uses the user-entered key from in-app Settings (SecureStore).
# Do NOT add the EXPO_PUBLIC_ prefix — it must stay off the client bundle.
GEMINI_API_KEY=your-gemini-api-key

# EAS Production Build ----------------------------------------------------
# Variables above are read from .env in local dev. For `eas build`,
# register them once on EAS so every build picks them up automatically:
#
#   eas secret:create --scope project --name EXPO_PUBLIC_SUPABASE_URL --value "<url>"
#   eas secret:create --scope project --name EXPO_PUBLIC_SUPABASE_ANON_KEY --value "<key>"
#   eas secret:create --scope project --name EXPO_PUBLIC_GOOGLE_CLIENT_ID --value "<id>"
#
# Google Services file (Firebase / Google Sign-In Android config) MUST be
# a file-type secret (path resolved by app.config.js → googleServicesFile):
#
#   eas secret:create --scope project --name GOOGLE_SERVICES_JSON --type file --value ./google-services.json
#
# Verify with: eas secret:list
