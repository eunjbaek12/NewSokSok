# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
ios/
android/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# Curation build raw data (re-downloadable; see scripts/build-jp-source.ts)
scripts/data/

# Curation enrich progress files (resumable state; not source of truth)
scripts/.*-progress.json

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo
.vercel

.env

# Android sensitive files
google-services.json
*.keystore
debug.keystore

# Build artifacts
server_dist/
.gradle/
app/src/

# Tooling caches
.playwright-cli/

# Editor / debug leftovers
*.bak
*.log
debug.log

# Claude Code runtime files
.claude/scheduled_tasks.lock
# 머신 로컬 권한·설정 (액세스 토큰 등 시크릿이 섞일 수 있어 추적 제외)
.claude/settings.local.json

# Play Store raw screenshots (대용량 PNG. final/만 commit)
store-assets/screenshots/raw/

# App Store iOS raw screenshots (아이폰 실기 캡처 원본. final/만 commit, raw/{ko,en}/ 디렉토리는 .gitkeep로 유지)
store-assets/screenshots/appstore/raw/**/*.png
store-assets/screenshots/appstore/raw/**/*.jpg

# Play Store Android raw screenshots (안드로이드 실기 캡처 원본. final/만 commit, raw/{ko,en}/ 디렉토리는 .gitkeep로 유지)
store-assets/screenshots/playstore/raw/**/*.png
store-assets/screenshots/playstore/raw/**/*.jpg

# Marketing teaser raw 영상/소스 (작업용. CapCut 조립 전 raw — 미추적. docs/handoff-marketing-teasers.md 참조)
assets/marketing/
assets/images/*.mp4

# 마일스톤 히어로 원본 (Gemini 2048px 생성본, OneDrive 백업. 앱은 512px 리사이즈본만 번들)
store-assets/milestones-source/

# Supabase CLI 캐시 (link 정보, 버전 캐시 등 로컬 한정)
supabase/.temp/

# 캐시 시딩 실행 산출물 (scripts/seed-cache.ts)
seed-cache-report.json
seed-cache-unsaved.json
.seed-input/
.tmp-wordfreq/

# 한국어 사다리 재설계 중간 산출물 (재생성 가능)
scripts/.ko-ladder-new-terms.json
scripts/.ko-ladder-cache-gap.json
scripts/.mono-review.json

# 29번 줄 scripts/.*-progress.json 의 예외. 다른 덱 파이프라인의 progress 는
# 계속 무시하지만 이것만은 추적한다 — 생성한 카드가 들어 있고 무료 한도가
# 모델당 하루 20요청(=500단어)이라 다시 만들려면 사흘이다. 재생성 가능이 아니다.
!scripts/.ko-ladder-progress.json
