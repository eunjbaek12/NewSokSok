# Required for production builds ------------------------------------------

# Supabase project (https://supabase.com — Settings → API)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Google Sign-In Web Client ID (Google Cloud Console → Credentials)
EXPO_PUBLIC_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# Optional — dev scripts only --------------------------------------------
# Production uses the user-entered key (SecureStore). Do NOT add the
# EXPO_PUBLIC_ prefix to this — it must stay off the client bundle.
GEMINI_API_KEY=your-gemini-api-key
