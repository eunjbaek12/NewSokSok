{
  "expo": {
    "name": "Avocado",
    "slug": "soksok-voca",
    "version": "1.1.4",
    "orientation": "portrait",
    "locales": {
      "ko": "./languages/ko.json",
      "en": "./languages/en.json"
    },
    "icon": "./assets/images/icon.png",
    "scheme": "soksokvoca",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#2A7B78"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.soksokvoca",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true,
        "NSSpeechRecognitionUsageDescription": "Avocado uses speech recognition for voice input.",
        "NSMicrophoneUsageDescription": "Avocado uses the microphone for voice input.",
        "NSCameraUsageDescription": "Avocado uses the camera to scan word lists from photos.",
        "NSPhotoLibraryUsageDescription": "Avocado imports word list photos from your library.",
        "NSPhotoLibraryAddUsageDescription": "Avocado saves your learning stats card to your photo library.",
        "NSUserTrackingUsageDescription": "This permission lets us show you more relevant ads. The app works the same if you decline."
      }
    },
    "android": {
      "package": "com.soksokvoca",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png",
        "backgroundColor": "#2A7B78"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-iap",
      [
        "expo-font",
        {
          "fonts": []
        }
      ],
      "@react-native-google-signin/google-signin",
      "expo-apple-authentication",
      "expo-tracking-transparency",
      "expo-web-browser",
      "expo-sqlite",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Avocado uses the microphone for voice input.",
          "speechRecognitionPermission": "Avocado uses speech recognition for voice input."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Avocado imports word list photos from your library.",
          "cameraPermission": "Avocado uses the camera to scan word lists from photos."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "2d560de2-a41b-4ac1-a019-d287f7aaa2d6"
      }
    }
  }
}
